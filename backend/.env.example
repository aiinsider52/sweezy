# App
APP_NAME=SWEEEZY Backend
APP_ENV=development
APP_VERSION=1.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sweeezy

# CORS
CORS_ORIGINS=["*"]

# Security
JWT_SECRET_KEY=please-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo admin (for JWT issuance)
ADMIN_EMAIL=admin@sweeezy.app
ADMIN_PASSWORD=admin123

# Transactional email (required in production for verification and password reset)
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@sweezy.app
RESEND_FROM_NAME=Sweezy

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0

# RemoteConfig flags
REMOTE_FLAGS={"enableNewOnboarding": true}

# Ask Sweezy (optional; citation-only fallback works without a key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ASK_SWEEZY_MAX_SOURCES=8

# Jobs catalog. Jooble requires a commercial API key. ATS lists are comma-separated
# company board identifiers approved for publication.
JOOBLE_API_KEY=
JOOBLE_SYNC_QUERIES=software,nurse,driver,warehouse,sales,marketing
JOOBLE_SYNC_PAGES=5
JOOBLE_RESULTS_PER_PAGE=50
GREENHOUSE_BOARD_TOKENS=
LEVER_SITES=
PERSONIO_COMPANIES=
PERSONIO_FEED_LANGUAGE=de
JOBS_SYNC_INTERVAL_SEC=1800
JOBS_STALE_AFTER_HOURS=48
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Marketplace chat. Redis is required in production for multi-instance realtime.
CHAT_ENABLED=true
REDIS_URL=redis://localhost:6379/0
CHAT_REDIS_CHANNEL=sweezy:chat:events

# Apple Push Notification service (.p8 key; use escaped newlines in Render)
PUSH_NOTIFICATIONS_ENABLED=false
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.sweezy.mobile
PUSH_SHOW_MESSAGE_PREVIEW=false
CHAT_OUTBOX_RETENTION_DAYS=30
PUSH_REVOKED_RETENTION_DAYS=30
