default_platform(:ios)

platform :ios do
  desc "Build for testing"
  lane :build do
    gym(
      scheme: "sweezy",
      project: "sweezy/sweezy.xcodeproj",
      configuration: "Debug",
      destination: "generic/platform=iOS"
    )
  end

  desc "Run tests"
  lane :tests do
    scan(
      scheme: "sweezy",
      project: "sweezy/sweezy.xcodeproj",
      devices: ["iPhone 15"]
    )
  end

  desc "Prepare metadata for App Store Connect"
  lane :metadata do
    deliver(
      submit_for_review: false,
      skip_metadata: false,
      # Screenshots are captured separately via scripts/capture-journey-screenshots.sh
      skip_screenshots: true,
      skip_binary_upload: true
    )
  end

  desc "Upload build to TestFlight (metadata optional)"
  lane :upload do
    build_app(
      scheme: "sweezy",
      project: "sweezy/sweezy.xcodeproj"
    )
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Upload metadata only (no binary)"
  lane :deliver_metadata do
    deliver(
      submit_for_review: false,
      skip_metadata: false,
      skip_screenshots: true,
      skip_binary_upload: true
    )
  end
end


