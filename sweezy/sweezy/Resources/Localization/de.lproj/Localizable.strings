"swiss.discovery.matterhorn.region" = "Zermatt · Wallis";
"swiss.discovery.matterhorn.summary" = "Schweizer Wahrzeichen auf 4478 m über autofreiem Zermatt, mit klassischem Blick von Gornergrat und Sunnegga.";
"swiss.discovery.matterhorn.tip" = "Bergwetter vor Abfahrt prüfen und früh starten. Sicht und Bedingungen können schnell wechseln.";
"swiss.discovery.matterhorn.season" = "Ganzjährig";
"swiss.discovery.matterhorn.duration" = "Ganzer Tag";
"swiss.discovery.matterhorn.route" = "Nach Zermatt fahren, Gornergratbahn nehmen und markiertem Panoramaweg folgen.";
"swiss.discovery.jungfraujoch.title" = "Jungfraujoch — Top of Europe";
"swiss.discovery.jungfraujoch.region" = "Berner Oberland";
"swiss.discovery.jungfraujoch.summary" = "Europas höchstgelegener Bahnhof auf 3454 m mit Gletscherblick, Sphinx-Terrasse und Eispalast.";
"swiss.discovery.jungfraujoch.tip" = "Von Mai bis August Sitzplatz reservieren und auch im Sommer warme Kleidung mitnehmen. Höhenhinweise beachten.";
"swiss.discovery.jungfraujoch.season" = "Ganzjährig";
"swiss.discovery.jungfraujoch.duration" = "Ganzer Tag";
"swiss.discovery.jungfraujoch.route" = "Grindelwald Terminal → Eiger Express → Eigergletscher → Jungfraujoch.";
"swiss.discovery.bern.title" = "Berner Altstadt";
"swiss.discovery.bern.region" = "Bern · BE";
"swiss.discovery.bern.summary" = "UNESCO-Altstadt mit sechs Kilometern Arkaden, Zytglogge, Münster und Blick auf Aare.";
"swiss.discovery.bern.tip" = "Am Rosengarten starten, durch Altstadt laufen und beim BärenPark an Aare enden.";
"swiss.discovery.bern.season" = "Ganzjährig";
"swiss.discovery.bern.duration" = "Halber oder ganzer Tag";
"swiss.discovery.bern.route" = "Bahnhof Bern → Bundesplatz → Zytglogge → Münster → BärenPark.";
"swiss.discovery.rigi.title" = "Rigi";
"swiss.discovery.rigi.region" = "Zentralschweiz";
"swiss.discovery.rigi.summary" = "Königin der Berge zwischen drei Seen, erreichbar per Schiff und Zahnradbahn mit 120 km Wanderwegen.";
"swiss.discovery.rigi.tip" = "Rundreise mit Schiff und Bahn planen und Bergfahrplan vor Abfahrt prüfen.";
"swiss.discovery.rigi.season" = "Ganzjährig";
"swiss.discovery.rigi.duration" = "Halber oder ganzer Tag";
"swiss.discovery.rigi.route" = "Luzern → Schiff nach Vitznau → Zahnradbahn nach Rigi Kulm.";
"swiss.discovery.aletsch.details" = "Aletschgletscher gehört zur UNESCO-Region Jungfrau-Aletsch. Aussichtspunkte Eggishorn, Bettmerhorn und Moosfluh zeigen Eisstrom, autofreie Bergdörfer und eine empfindliche Hochgebirgslandschaft, die sich durch den Klimawandel rasch verändert.";
"swiss.discovery.lavaux.details" = "Lavaux-Weinberge ziehen sich zwischen Lausanne und Montreux und prägen seit über acht Jahrhunderten die Kulturlandschaft über dem Genfersee. Wege verbinden Cully, Epesses, Rivaz und Winzerdörfer; die Bahn erleichtert kürzere Etappen.";
"swiss.discovery.creux.details" = "Creux du Van ist ein natürlicher Felsenkessel des Jura mit bis zu 160 Meter hohen Wänden. Die Runde ab Noiraigue führt durch Wald, Weiden und Aussichtspunkte; Gämsen und Steinböcke lassen sich mit Abstand und auf markierten Wegen beobachten.";
"swiss.discovery.rhine.details" = "Rheinfall zeigt sich von beiden Ufern: Plattformen bei Schloss Laufen führen nahe ans Wasser, Neuhausen bietet weite Sicht. Saisonale Boote fahren zum Mittelfelsen, abhängig von Wetter und Wasserstand.";
"swiss.discovery.oeschinen.details" = "Oeschinensee liegt in UNESCO-Berglandschaft oberhalb Kandersteg. Von Bergstation führt leichter Weg zum Ufer, daneben starten längere Panoramawege; empfindliche Natur schützen und aktuelle Einschränkungen prüfen.";
"swiss.discovery.ruinaulta.details" = "Rheinschlucht entstand nach Flimser Bergsturz und verbindet heute weisse Felsen, Wald und türkisfarbenen Vorderrhein. Erlebnis möglich vom Il Spir, auf Wanderung oder mit Rhätischer Bahn am Fluss.";
"swiss.discovery.generoso.details" = "Monte Generoso verbindet Zahnradbahn, Geologiepfade und Blicke über Tessiner Seen bis Norditalien. Mario Bottas Fiore di Pietra steht am Gipfel, wo kurze Spaziergänge und längere Bergwege beginnen.";
"swiss.discovery.st_gallen.details" = "Stiftsbezirk St. Gallen mit barocker Kathedrale und Bibliothek gehört zu UNESCO. Alte Handschriften liegen im Inneren; kompakte Altstadt ergänzt Erker, Textilgeschichte und Fussgängerzonen.";
"swiss.discovery.matterhorn.details" = "Matterhorn erhebt sich über autofreiem Zermatt mit Aussichtsrouten für jede Jahreszeit. Gornergrat bietet klassisches Gipfel- und Gletscherpanorama, Sunnegga eine schnellere Familienoption, Dorf bewahrt Alpinismusgeschichte.";
"swiss.discovery.jungfraujoch.details" = "Reise zum Jungfraujoch führt durch Berge zur Station auf 3454 Metern. Sphinx-Terrasse, Eispalast und Blick auf Aletschgletscher warten oben; warme Kleidung, ruhiges Tempo und Höhenhinweise sind wichtig.";
"swiss.discovery.bern.details" = "UNESCO-Altstadt Bern funktioniert dank sechs Kilometern Arkaden bei jedem Wetter. Kompakte Route verbindet Bundesplatz, Zytglogge, Münster, Aarebrücken und BärenPark.";
"swiss.discovery.rigi.details" = "Rigi liegt zwischen Vierwaldstätter-, Zuger- und Lauerzersee und ist mit historischer Zahnradbahn erreichbar. Rundreise mit Schiff und Zug verbindet Aussichtspunkte, leichte Wege, längere Touren und Mineralbad.";

"swiss.discovery.zurich.title" = "Zürich";
"swiss.discovery.zurich.region" = "Zürich · ZH";
"swiss.discovery.zurich.summary" = "See, Altstadt, Museen und einer der stärksten Innovationsstandorte Europas, verbunden durch schnellen öffentlichen Verkehr.";
"swiss.discovery.zurich.details" = "Zürich lässt sich gut zu Fuss entdecken: Vom Hauptbahnhof führt Bahnhofstrasse zu Lindenhof, Altstadt, Limmat und See. Grossmünster, Kunsthaus, Zürich-West sowie viele Orte für Technologie, Design und Unternehmertum liegen nah beieinander.";
"swiss.discovery.zurich.tip" = "Altstadt morgens, Zürich-West nach Mittag und See abends verbinden. ZVV-Tageskarte ist oft günstiger als Einzelfahrten.";
"swiss.discovery.zurich.season" = "Ganzjährig";
"swiss.discovery.zurich.duration" = "Ganzer Tag";
"swiss.discovery.zurich.route" = "Zürich HB → Bahnhofstrasse → Lindenhof → Grossmünster → Bellevue → Seepromenade.";
"swiss.discovery.geneva.title" = "Genf";
"swiss.discovery.geneva.region" = "Genf · GE";
"swiss.discovery.geneva.summary" = "Diplomatiestadt am See mit Jet d’Eau, Altstadt, UNO, Rotem Kreuz und internationaler Atmosphäre.";
"swiss.discovery.geneva.details" = "Genf verbindet Ufer mit Jet d’Eau, historischen Kern um Kathedrale Saint-Pierre und internationales Viertel beim Palais des Nations. Museen, CERN, Uhrmachertradition und französische Alpen passen zu Freizeit- wie Geschäftsreise.";
"swiss.discovery.geneva.tip" = "Jet d’Eau hängt vom Wetter ab. Für UNO- oder CERN-Besuche Reservierung und Ausweisanforderungen vorher prüfen.";
"swiss.discovery.geneva.season" = "Ganzjährig";
"swiss.discovery.geneva.duration" = "Ganzer Tag";
"swiss.discovery.geneva.route" = "Gare Cornavin → See → Jet d’Eau → Altstadt → Tram zu Nations.";
"swiss.discovery.lucerne.title" = "Luzern";
"swiss.discovery.lucerne.region" = "Luzern · LU";
"swiss.discovery.lucerne.summary" = "Kapellbrücke, Altstadt, Vierwaldstättersee sowie Pilatus und Rigi in einem kompakten Ziel.";
"swiss.discovery.lucerne.details" = "Luzern beginnt bequem am Bahnhof neben KKL, Ufer, Kapellbrücke und bemalten Altstadtfassaden. Schiffe fahren weiter nach Vitznau oder Alpnachstad zu Bergbahnen auf Rigi oder Pilatus.";
"swiss.discovery.lucerne.tip" = "Fahrpläne von Schiffen und Bergbahnen für Rundreise prüfen. Bei klarem Himmel Nachmittag für Gipfel reservieren.";
"swiss.discovery.lucerne.season" = "Ganzjährig";
"swiss.discovery.lucerne.duration" = "Halber oder ganzer Tag";
"swiss.discovery.lucerne.route" = "Bahnhof → KKL → Kapellbrücke → Altstadt → Löwendenkmal → Ufer.";
"swiss.discovery.basel.title" = "Basel";
"swiss.discovery.basel.region" = "Basel · BS";
"swiss.discovery.basel.summary" = "Kunststadt am Rhein mit Museen von Weltrang, moderner Architektur und lebendiger Altstadt.";
"swiss.discovery.basel.details" = "Basel verbindet Kunstmuseum, Fondation Beyeler, Messe Basel und Architektur internationaler Büros. Rathaus, Münster und Rheinpromenade ergeben leichte Fussroute; traditionelle Fähren nutzen nur Strömung.";
"swiss.discovery.basel.tip" = "Öffnungstage und Kombitickets der Museen prüfen. Im Rhein nur an offiziellen Stellen und bei sicheren Bedingungen schwimmen.";
"swiss.discovery.basel.season" = "Ganzjährig";
"swiss.discovery.basel.duration" = "Ganzer Tag";
"swiss.discovery.basel.route" = "Barfüsserplatz → Rathaus → Münster → Rhein → Museumsviertel.";
"swiss.discovery.lausanne.title" = "Lausanne";
"swiss.discovery.lausanne.region" = "Waadt · VD";
"swiss.discovery.lausanne.summary" = "Hügelstadt mit gotischer Kathedrale, Olympischem Museum, Ouchy-Ufer und Alpenblick.";
"swiss.discovery.lausanne.details" = "Lausanne steigt vom See zum mittelalterlichen Zentrum, daher verbindet Metro M2 Ouchy, Bahnhof und Kathedrale. Stadt vereint Olympisches Museum, Hochschulen, Start-ups und direkten Zugang zu Lavaux.";
"swiss.discovery.lausanne.tip" = "Hänge sind steil: bergab laufen, bergauf Metro nehmen. Tageskarte erleichtert Route.";
"swiss.discovery.lausanne.season" = "Ganzjährig";
"swiss.discovery.lausanne.duration" = "Ganzer Tag";
"swiss.discovery.lausanne.route" = "Kathedrale → Place de la Palud → Metro M2 → Ouchy → Olympisches Museum.";
"swiss.discovery.montreux.title" = "Montreux";
"swiss.discovery.montreux.region" = "Waadt · Genfersee";
"swiss.discovery.montreux.summary" = "Palmenpromenade, Schloss Chillon, Musikgeschichte und Alpenblick an Schweizer Riviera.";
"swiss.discovery.montreux.details" = "Montreux zieht sich am See zwischen Gärten, Belle-Époque-Hotels und Musikorten entlang. Weiterfahrt möglich zu Château de Chillon, Lavaux oder Panoramabahn Rochers-de-Naye.";
"swiss.discovery.montreux.tip" = "Ufer mit Schloss Chillon verbinden. Während Festivals Verkehr und Unterkunft früh buchen.";
"swiss.discovery.montreux.season" = "Ganzjährig";
"swiss.discovery.montreux.duration" = "Halber oder ganzer Tag";
"swiss.discovery.montreux.route" = "Bahnhof → Promenade → Freddie-Mercury-Denkmal → Schiff oder Bus zum Château de Chillon.";
"swiss.discovery.lugano.title" = "Lugano";
"swiss.discovery.lugano.region" = "Tessin · TI";
"swiss.discovery.lugano.summary" = "Mediterrane Atmosphäre, See, italienische Gassen und Panoramen von Monte Brè und San Salvatore.";
"swiss.discovery.lugano.details" = "Lugano verbindet Piazza della Riforma, Parco Ciani, Kulturzentrum LAC und lange Seepromenade. Standseilbahnen auf Monte Brè und San Salvatore öffnen einfachen Zugang zu Panoramawegen über Stadt.";
"swiss.discovery.lugano.tip" = "Saisonale Fahrpläne von Schiffen und Bahnen prüfen. Gäste vieler Hotels erhalten Ticino Ticket.";
"swiss.discovery.lugano.season" = "Ganzjährig";
"swiss.discovery.lugano.duration" = "Ganzer Tag";
"swiss.discovery.lugano.route" = "Bahnhof → Piazza della Riforma → LAC → Parco Ciani → Ufer.";
"swiss.discovery.davos.title" = "Davos";
"swiss.discovery.davos.region" = "Graubünden · GR";
"swiss.discovery.davos.summary" = "Hochalpine Stadt mit See, Parsenn-Routen, Kongressgeschichte und Kultur auf 1560 Metern.";
"swiss.discovery.davos.details" = "Davos ist Alpenort und internationales Tagungsziel. Bergbahnen führen zu Parsenn und Jakobshorn, Standseilbahn zur Schatzalp; Kirchner Museum und See bieten ruhigere Alternativen.";
"swiss.discovery.davos.tip" = "Höhe und schnellen Wetterwechsel beachten. Gästekarte, Liftsaison und Wegzustand prüfen.";
"swiss.discovery.davos.season" = "Ganzjährig";
"swiss.discovery.davos.duration" = "Halber oder ganzer Tag";
"swiss.discovery.davos.route" = "Davos Platz → Kirchner Museum → Schatzalp oder Davos Dorf → Parsenn.";
"swiss.discovery.ascona.title" = "Ascona";
"swiss.discovery.ascona.region" = "Tessin · Lago Maggiore";
"swiss.discovery.ascona.summary" = "Farbige Lago-Maggiore-Promenade, Altstadt, Kunstgeschichte von Monte Verità und nahes Locarno.";
"swiss.discovery.ascona.details" = "Ascona hat fast mediterranen Rhythmus: Piazza Giuseppe Motta öffnet sich zum See, enge Gassen führen zu Galerien und Kirchen. Monte Verità erzählt von Künstlern und Reformern, Schiffe verbinden Brissago-Inseln.";
"swiss.discovery.ascona.tip" = "Promenade ist am Wochenende voll. Schiffsplan prüfen und früh für ruhigen Spaziergang kommen.";
"swiss.discovery.ascona.season" = "März — November";
"swiss.discovery.ascona.duration" = "Halber Tag";
"swiss.discovery.ascona.route" = "Piazza Motta → Altstadt → Monte Verità → Schiff zu Brissago-Inseln.";
"swiss.discovery.engadin.title" = "Engadin und St. Moritz";
"swiss.discovery.engadin.region" = "Graubünden · GR";
"swiss.discovery.engadin.summary" = "Hochgebirgsseen, romanische Dörfer, Berninabahn und Routen rund um St. Moritz.";
"swiss.discovery.engadin.details" = "Engadin verbindet Seen St. Moritz, Silvaplana und Sils mit Sgraffito-Dörfern. Rhätische Bahn, Muottas Muragl, Zuoz und Berninaroute bieten leichte Panoramen bis zu ganzen Bergtagen.";
"swiss.discovery.engadin.tip" = "Höhe ist auch auf leichten Wegen spürbar. Wetter, RhB-Tickets und Gästeangebote prüfen.";
"swiss.discovery.engadin.season" = "Ganzjährig";
"swiss.discovery.engadin.duration" = "Ganzer Tag";
"swiss.discovery.engadin.route" = "St. Moritz → Seeweg → Muottas Muragl oder RhB nach Pontresina und Bernina.";
