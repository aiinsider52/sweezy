"swiss.discovery.interlaken.title" = "Interlaken";
"swiss.discovery.interlaken.region" = "Berner Oberland · zwischen zwei Seen";
"swiss.discovery.interlaken.summary" = "Ein Ort zwischen Thuner- und Brienzersee, ideal für Bergtouren und ruhige Wege am Wasser.";
"swiss.discovery.interlaken.details" = "Interlaken verbindet gute städtische Infrastruktur mit direktem Zugang zu den Alpen. Nach Uferweg und Höhematte führen direkte Züge in die Täler von Lauterbrunnen oder Grindelwald. Als Tagesziel funktioniert der Ort gut, als Basis für mehrere Tage noch besser: ein Tag am See, einer für die Bergbahn und einer für die Stadt.";
"swiss.discovery.interlaken.tip" = "Pro Tag einen See und eine Bergrichtung wählen. Wetter und Fahrplan vor der Abfahrt prüfen.";
"swiss.discovery.interlaken.season" = "Ganzjährig";
"swiss.discovery.interlaken.duration" = "1–3 Tage";
"swiss.discovery.interlaken.route" = "Interlaken Ost → Höhematte → Ufer oder Zug in ein Alpental";

"swiss.discovery.crans_montana.title" = "Crans-Montana";
"swiss.discovery.crans_montana.region" = "Wallis · sonniges Alpenplateau";
"swiss.discovery.crans_montana.summary" = "Panoramaort über dem Rhonetal mit Seen, Wegen, Bergbahnen und Weinbergen.";
"swiss.discovery.crans_montana.details" = "Crans-Montana liegt auf einem breiten Sonnenplateau und verbindet komfortable Infrastruktur mit freier Alpensicht und kurzen Wegen. Im Sommer lassen sich ein Spaziergang um die Seen und eine Bergbahnfahrt gut kombinieren; weiter unten ergänzt das Weinwallis den Tag mit einer ganz anderen Landschaft.";
"swiss.discovery.crans_montana.tip" = "Früh in die Berge starten und den Nachmittag für einen See oder ein Weindorf im Tal reservieren.";
"swiss.discovery.crans_montana.season" = "Ganzjährig";
"swiss.discovery.crans_montana.duration" = "1–2 Tage";
"swiss.discovery.crans_montana.route" = "Montana Gare → Seen → Bergbahn → Panoramaweg";

"swiss.discovery.locarno.title" = "Locarno";
"swiss.discovery.locarno.region" = "Tessin · Lago Maggiore";
"swiss.discovery.locarno.summary" = "Palmen, Piazza Grande und ein schneller Aufstieg vom See zu Aussichtspunkten über dem Tessin.";
"swiss.discovery.locarno.details" = "Locarno wirkt fast mediterran: Altstadtarkaden, Gärten und Uferpromenade ergeben eine kompakte Route. Eine Standseilbahn führt zur Madonna del Sasso, weitere Bahnen öffnen den Blick über See und Voralpen. Ein unkomplizierter Einstieg ins Tessin ohne Auto.";
"swiss.discovery.locarno.tip" = "Altstadt am Morgen, Heiligtum vor dem Mittag und den Abend für die Uferpromenade einplanen.";
"swiss.discovery.locarno.season" = "Frühling bis Herbst";
"swiss.discovery.locarno.duration" = "1–2 Tage";
"swiss.discovery.locarno.route" = "Piazza Grande → Altstadt → Madonna del Sasso → Seeufer";

"swiss.discovery.martigny.title" = "Martigny";
"swiss.discovery.martigny.region" = "Wallis · Kreuzung der Alpenrouten";
"swiss.discovery.martigny.summary" = "Römisches Erbe, Kunst, Weinberge und eine Burg in einer kompakten Stadt bei wichtigen Alpenpässen.";
"swiss.discovery.martigny.details" = "Martigny zeigt Geschichte vom römischen Amphitheater bis zum mittelalterlichen Château de la Bâtiaz. Kulturorte liegen zwischen Obstgärten und Reben im Rhonetal. Der Ort ist zudem eine gute Basis für Saint-Maurice, Emosson und Routen Richtung Frankreich und Italien.";
"swiss.discovery.martigny.tip" = "Amphitheater und Museum vormittags verbinden, am Abend zur Burg oder in die Weinberge gehen.";
"swiss.discovery.martigny.season" = "Ganzjährig";
"swiss.discovery.martigny.duration" = "1 Tag";
"swiss.discovery.martigny.route" = "Bahnhof → historisches Zentrum → Amphitheater → Château de la Bâtiaz";

"swiss.discovery.flims_laax.title" = "Flims–Laax–Falera";
"swiss.discovery.flims_laax.region" = "Graubünden · Seen und Rheinschlucht";
"swiss.discovery.flims_laax.summary" = "Türkisfarbene Waldseen, Hochgebirgswege und moderne Verbindungen direkt bei der Ruinaulta.";
"swiss.discovery.flims_laax.details" = "Flims–Laax–Falera vereint auf kleinem Raum den klaren Caumasee, Waldwege, Aussichtspunkte über der Rheinschlucht und höhere Bergtouren. Der Ortsverkehr verbindet die Dörfer und macht Rundwanderungen ohne Auto möglich.";
"swiss.discovery.flims_laax.tip" = "Für einen leichten Tag Caumasee und Il Spir verbinden. Hochalpine Tour und Bahnbetrieb separat prüfen.";
"swiss.discovery.flims_laax.season" = "Ganzjährig";
"swiss.discovery.flims_laax.duration" = "1–3 Tage";
"swiss.discovery.flims_laax.route" = "Flims Waldhaus → Caumasee → Conn → Aussichtspunkt Il Spir";

"swiss.discovery.vaud.title" = "Region Waadt";
"swiss.discovery.vaud.region" = "Genfersee · Städte, Reben und Jura";
"swiss.discovery.vaud.summary" = "Von Lausanne und Morges zu Seeufern, Weinbergen und ruhigen Routen am Jurafuss.";
"swiss.discovery.vaud.details" = "Die Waadt verbindet urbane Kultur, Seelandschaften und Winzerdörfer mit einem dichten Bahnnetz. Start am Markt und Ufer von Morges, weiter zu Lausannes Museen oder Schlössern am See und am nächsten Tag in die Rebberge oder ins Vallée de Joux.";
