"swiss.discovery.aletsch.title" = "Great Aletsch Glacier";
"swiss.discovery.aletsch.region" = "Valais · Aletsch Arena";
"swiss.discovery.aletsch.summary" = "See Alps’ longest glacier from Eggishorn viewpoint and explore high-altitude car-free villages.";
"swiss.discovery.aletsch.tip" = "Go up in morning for clearer views and fewer visitors. Check cable-car operations before departure.";
"swiss.discovery.aletsch.season" = "June — October";
"swiss.discovery.aletsch.duration" = "Half day";
"swiss.discovery.aletsch.route" = "Train to Fiesch, cable car to Eggishorn, then short panoramic walk.";

"swiss.discovery.lavaux.title" = "Lavaux Vineyards";
"swiss.discovery.lavaux.region" = "Vaud · Lake Geneva";
"swiss.discovery.lavaux.summary" = "UNESCO vineyard terraces descend toward Lake Geneva and frame one of Switzerland’s warmest landscapes.";
"swiss.discovery.lavaux.tip" = "Walk one section between wine villages and return by train. Bring water and sun protection in summer.";
"swiss.discovery.lavaux.season" = "May — October";
"swiss.discovery.lavaux.duration" = "2–4 hours";
"swiss.discovery.lavaux.route" = "Train to Cully or Rivaz, then walk across terraces. Lakeside stations make route easy to shorten.";

"swiss.discovery.creux.title" = "Creux du Van";
"swiss.discovery.creux.region" = "Neuchâtel · Jura";
"swiss.discovery.creux.summary" = "Natural rock amphitheatre about 1.4 km wide, with vertical walls and wild Jura scenery.";
"swiss.discovery.creux.tip" = "Plateau weather changes fast. Wear hiking shoes, avoid cliff edge in fog and never feed wildlife.";
"swiss.discovery.creux.season" = "May — October";
"swiss.discovery.creux.duration" = "4–5 hours";
"swiss.discovery.creux.route" = "Circular hike from Noiraigue. Mountain route is not suitable for barrier-free visits.";

"swiss.discovery.rhine.title" = "Rhine Falls";
"swiss.discovery.rhine.region" = "Schaffhausen · Neuhausen";
"swiss.discovery.rhine.summary" = "Europe’s most powerful waterfall, with viewpoints close to water and seasonal boats below the falls.";
"swiss.discovery.rhine.tip" = "Arrive early or near evening. Boats are seasonal, so check timetable and water conditions first.";
"swiss.discovery.rhine.season" = "All year";
"swiss.discovery.rhine.duration" = "1–3 hours";
"swiss.discovery.rhine.route" = "Train to Schloss Laufen am Rheinfall or Neuhausen Rheinfall. Some viewing areas offer easier access.";

"swiss.discovery.oeschinen.title" = "Lake Oeschinen";
"swiss.discovery.oeschinen.region" = "Bernese Oberland · Kandersteg";
"swiss.discovery.oeschinen.summary" = "Turquoise alpine lake below Blüemlisalp cliffs, ideal for gentle walks, picnics or mountain hikes.";
"swiss.discovery.oeschinen.tip" = "Reserve gondola time on popular days. Swimming depends on temperature and drones are restricted in protected area.";
"swiss.discovery.oeschinen.season" = "All year";
"swiss.discovery.oeschinen.duration" = "Half day";
"swiss.discovery.oeschinen.route" = "Gondola from Kandersteg, then roughly 25–30 minutes on foot. Broad easy path starts at upper station.";

"swiss.discovery.ruinaulta.title" = "Ruinaulta Rhine Gorge";
"swiss.discovery.ruinaulta.region" = "Graubünden · Flims";
"swiss.discovery.ruinaulta.summary" = "White cliffs, turquoise Vorderrhein and red Rhaetian trains form Switzerland’s own Grand Canyon.";
"swiss.discovery.ruinaulta.tip" = "For easy day, combine Il Spir viewpoint with train through gorge. Check trail status before longer hikes.";
"swiss.discovery.ruinaulta.season" = "All year";
"swiss.discovery.ruinaulta.duration" = "2–5 hours";
"swiss.discovery.ruinaulta.route" = "Bus to Flims Waldhaus and walk to Il Spir, or take panoramic rail journey along Rhine.";

"swiss.discovery.generoso.title" = "Monte Generoso";
"swiss.discovery.generoso.region" = "Ticino · Mendrisio";
"swiss.discovery.generoso.summary" = "Cog railway climbs to 1,704 m, Fiore di Pietra and wide views over lakes, Alps and northern Italy.";
"swiss.discovery.generoso.tip" = "Check summit forecast and seasonal train timetable. Wind can be strong even on warm days.";
"swiss.discovery.generoso.season" = "Spring — autumn";
"swiss.discovery.generoso.duration" = "Half day";
"swiss.discovery.generoso.route" = "Cog railway from Capolago to summit, with short walks and longer mountain trails.";

"swiss.discovery.st_gallen.title" = "St. Gall Abbey District";
"swiss.discovery.st_gallen.region" = "St. Gallen · SG";
"swiss.discovery.st_gallen.summary" = "UNESCO ensemble with Baroque cathedral and one of world’s oldest libraries, located in city centre.";
"swiss.discovery.st_gallen.tip" = "Check library hours and seasonal closures. Photography and protective footwear rules apply inside.";
"swiss.discovery.st_gallen.season" = "All year";
"swiss.discovery.st_gallen.duration" = "1–2 hours";
"swiss.discovery.st_gallen.route" = "Short walk from St. Gallen station through old town to cathedral and Abbey Library.";

"swiss.discovery.matterhorn.title" = "Matterhorn";
"swiss.discovery.matterhorn.region" = "Zermatt · Valais";
"swiss.discovery.matterhorn.summary" = "Switzerland’s 4,478 m icon above car-free Zermatt, with classic views from Gornergrat and Sunnegga.";
"swiss.discovery.matterhorn.tip" = "Check mountain weather before departure and start early. Visibility and conditions can change quickly.";
"swiss.discovery.matterhorn.season" = "All year";
"swiss.discovery.matterhorn.duration" = "Full day";
"swiss.discovery.matterhorn.route" = "Travel to Zermatt, take the Gornergrat railway, then follow a marked panoramic walk.";
"swiss.discovery.jungfraujoch.title" = "Jungfraujoch — Top of Europe";
"swiss.discovery.jungfraujoch.region" = "Bernese Oberland";
"swiss.discovery.jungfraujoch.summary" = "Europe’s highest railway station at 3,454 m, with glacier views, Sphinx terrace and Ice Palace.";
"swiss.discovery.jungfraujoch.tip" = "Reserve seats from May to August and bring warm layers even in summer. Check altitude guidance before visiting.";
"swiss.discovery.jungfraujoch.season" = "All year";
"swiss.discovery.jungfraujoch.duration" = "Full day";
"swiss.discovery.jungfraujoch.route" = "Grindelwald Terminal → Eiger Express → Eigergletscher → Jungfraujoch.";
"swiss.discovery.bern.title" = "Bern Old Town";
"swiss.discovery.bern.region" = "Bern · BE";
"swiss.discovery.bern.summary" = "UNESCO-listed old town with six kilometres of arcades, Zytglogge, cathedral and river views.";
"swiss.discovery.bern.tip" = "Start at Rosengarten, walk through old town, then finish at Bear Park beside Aare.";
"swiss.discovery.bern.season" = "All year";
"swiss.discovery.bern.duration" = "Half or full day";
"swiss.discovery.bern.route" = "Bern station → Bundesplatz → Zytglogge → cathedral → Bear Park.";
"swiss.discovery.rigi.title" = "Mount Rigi";
"swiss.discovery.rigi.region" = "Central Switzerland";
"swiss.discovery.rigi.summary" = "Queen of the Mountains between three lakes, reached by boat and cogwheel railway with 120 km of paths.";
"swiss.discovery.rigi.tip" = "Build a round trip with boat and train, and check mountain timetable before departure.";
"swiss.discovery.rigi.season" = "All year";
"swiss.discovery.rigi.duration" = "Half or full day";
"swiss.discovery.rigi.route" = "Lucerne → boat to Vitznau → cogwheel railway to Rigi Kulm.";
"swiss.discovery.aletsch.details" = "Aletsch Glacier belongs to the UNESCO-listed Jungfrau-Aletsch region. Viewpoints at Eggishorn, Bettmerhorn and Moosfluh reveal the ice stream, car-free mountain villages and a fragile alpine landscape changing quickly with the climate.";
"swiss.discovery.lavaux.details" = "Lavaux vineyards stretch between Lausanne and Montreux and have shaped the cultural landscape above Lake Geneva for more than eight centuries. Trails connect Cully, Epesses, Rivaz and wine villages, while the railway makes shorter routes easy.";
"swiss.discovery.creux.details" = "Creux du Van is a natural Jura rock amphitheatre with walls up to 160 metres high. The loop from Noiraigue crosses forest, pasture and viewpoints; chamois and ibex may appear if visitors keep distance and stay on trail.";
"swiss.discovery.rhine.details" = "Rhine Falls is best explored from both banks: Schloss Laufen platforms lead close to the water, while Neuhausen offers a wide panorama. Seasonal boats reach the central rock, with service depending on weather and water levels.";
"swiss.discovery.oeschinen.details" = "Oeschinen Lake sits in a UNESCO alpine landscape above Kandersteg. From the gondola top station, choose an easy walk to the shore or longer panorama trails; protect the sensitive environment and check current restrictions before travel.";
"swiss.discovery.ruinaulta.details" = "Rhine Gorge formed after the huge Flims rockslide and now combines white cliffs, forest and turquoise Vorderrhein water. See it from Il Spir, hike through the gorge or ride the Rhaetian Railway beside the river.";
"swiss.discovery.generoso.details" = "Monte Generoso combines a cogwheel railway, geology trails and views across Ticino lakes and northern Italy. Mario Botta’s Fiore di Pietra stands at the summit, where short walks and longer mountain paths begin.";
"swiss.discovery.st_gallen.details" = "St Gallen’s Abbey District, with its baroque cathedral and library, is UNESCO-listed. Ancient manuscripts are preserved inside, while the compact old town adds ornate bay windows, textile heritage and pedestrian streets.";
"swiss.discovery.matterhorn.details" = "Matterhorn rises above car-free Zermatt with viewpoints for every season. Gornergrat gives the classic summit-and-glacier panorama, Sunnegga offers a quicker family option, and the village preserves rich mountaineering history.";
"swiss.discovery.jungfraujoch.details" = "The journey to Jungfraujoch travels through the mountains to a station at 3,454 metres. The Sphinx terrace, Ice Palace and Aletsch Glacier panorama await above; warm layers, a slow pace and attention to altitude guidance are essential.";
"swiss.discovery.bern.details" = "Bern’s UNESCO old town works in any weather thanks to six kilometres of arcades. A compact walking route connects Bundesplatz, Zytglogge, the cathedral, bridges over the Aare and BärenPark.";
"swiss.discovery.rigi.details" = "Rigi sits between Lakes Lucerne, Zug and Lauerz and is reached by a historic cogwheel railway. A round trip by boat and train links panorama stops, easy walks, longer trails and mineral baths.";

"swiss.discovery.zurich.title" = "Zurich";
"swiss.discovery.zurich.region" = "Zurich · ZH";
"swiss.discovery.zurich.summary" = "Lakefront, old town, museums and one of Europe’s strongest innovation hubs, all linked by fast public transport.";
"swiss.discovery.zurich.details" = "Zurich is easy to explore on foot: from the main station, Bahnhofstrasse leads to Lindenhof, the old town, the Limmat and the lake. Grossmünster, Kunsthaus, Zürich-West and many technology, design and entrepreneurship spaces sit nearby.";
"swiss.discovery.zurich.tip" = "Combine old town in the morning, Zürich-West after lunch and the lake in the evening. A ZVV day pass often costs less than separate rides.";
"swiss.discovery.zurich.season" = "All year";
"swiss.discovery.zurich.duration" = "Full day";
"swiss.discovery.zurich.route" = "Zürich HB → Bahnhofstrasse → Lindenhof → Grossmünster → Bellevue → lake promenade.";
"swiss.discovery.geneva.title" = "Geneva";
"swiss.discovery.geneva.region" = "Geneva · GE";
"swiss.discovery.geneva.summary" = "A diplomatic city on the lake with Jet d’Eau, old town, the UN, Red Cross and an international atmosphere.";
"swiss.discovery.geneva.details" = "Geneva combines the Jet d’Eau waterfront, the historic centre around Saint-Pierre Cathedral and the international district around Palais des Nations. Museums, CERN, watchmaking heritage and nearby French Alps serve leisure and business trips alike.";
"swiss.discovery.geneva.tip" = "Jet d’Eau operation depends on weather. Check reservations and identification requirements for UN or CERN tours in advance.";
"swiss.discovery.geneva.season" = "All year";
"swiss.discovery.geneva.duration" = "Full day";
"swiss.discovery.geneva.route" = "Gare Cornavin → lake → Jet d’Eau → old town → tram to Nations.";
"swiss.discovery.lucerne.title" = "Lucerne";
"swiss.discovery.lucerne.region" = "Lucerne · LU";
"swiss.discovery.lucerne.summary" = "Chapel Bridge, old town, Lake Lucerne and Mount Pilatus and Rigi in one compact destination.";
"swiss.discovery.lucerne.details" = "Lucerne starts conveniently at the station beside KKL, the waterfront, Chapel Bridge and painted old-town façades. Boats continue to Vitznau or Alpnachstad for mountain railways up Rigi or Pilatus.";
"swiss.discovery.lucerne.tip" = "Check boat and mountain railway timetables for a circular trip. Save the afternoon for a summit when skies are clear.";
"swiss.discovery.lucerne.season" = "All year";
"swiss.discovery.lucerne.duration" = "Half or full day";
"swiss.discovery.lucerne.route" = "Station → KKL → Chapel Bridge → old town → Lion Monument → waterfront.";
"swiss.discovery.basel.title" = "Basel";
"swiss.discovery.basel.region" = "Basel · BS";
"swiss.discovery.basel.summary" = "Art capital on the Rhine with world-class museums, contemporary architecture and a lively old town.";
"swiss.discovery.basel.details" = "Basel brings together Kunstmuseum, Fondation Beyeler, Messe Basel and architecture by global studios. Rathaus, the cathedral and Rhine promenade form an easy walking route, while traditional ferries cross using only the current.";
"swiss.discovery.basel.tip" = "Check museum opening days and combination tickets. Swim in the Rhine only in official areas and safe conditions.";
"swiss.discovery.basel.season" = "All year";
"swiss.discovery.basel.duration" = "Full day";
"swiss.discovery.basel.route" = "Barfüsserplatz → Rathaus → cathedral → Rhine → museum district.";
"swiss.discovery.lausanne.title" = "Lausanne";
"swiss.discovery.lausanne.region" = "Vaud · VD";
"swiss.discovery.lausanne.summary" = "A hillside city with a Gothic cathedral, Olympic Museum, Ouchy waterfront and Alpine views.";
"swiss.discovery.lausanne.details" = "Lausanne climbs from the lake to its medieval centre, so metro M2 conveniently links Ouchy, the station and cathedral. The city combines the Olympic Museum, universities, startups and immediate access to Lavaux vineyards.";
"swiss.discovery.lausanne.tip" = "Hills are steep: walk downhill and use the metro uphill. A day transport ticket makes the route easier.";
"swiss.discovery.lausanne.season" = "All year";
"swiss.discovery.lausanne.duration" = "Full day";
"swiss.discovery.lausanne.route" = "Cathedral → Place de la Palud → metro M2 → Ouchy → Olympic Museum.";
"swiss.discovery.montreux.title" = "Montreux";
"swiss.discovery.montreux.region" = "Vaud · Lake Geneva";
"swiss.discovery.montreux.summary" = "Palm-lined promenade, Chillon Castle, music heritage and Alpine views on the Swiss Riviera.";
"swiss.discovery.montreux.details" = "Montreux stretches along the lake between gardens, Belle Époque hotels and music venues. Continue to Château de Chillon, Lavaux vineyards or the Rochers-de-Naye panorama railway.";
"swiss.discovery.montreux.tip" = "Combine the waterfront with Chillon Castle. Book transport and accommodation early during festivals.";
"swiss.discovery.montreux.season" = "All year";
"swiss.discovery.montreux.duration" = "Half or full day";
"swiss.discovery.montreux.route" = "Station → promenade → Freddie Mercury statue → boat or bus to Château de Chillon.";
"swiss.discovery.lugano.title" = "Lugano";
"swiss.discovery.lugano.region" = "Ticino · TI";
"swiss.discovery.lugano.summary" = "Mediterranean atmosphere, lake, Italianate streets and panoramas from Monte Brè and San Salvatore.";
"swiss.discovery.lugano.details" = "Lugano combines Piazza della Riforma, Parco Ciani, LAC cultural centre and a long lake promenade. Funiculars to Monte Brè and San Salvatore provide easy access to panoramic trails above town.";
"swiss.discovery.lugano.tip" = "Check seasonal boat and funicular timetables. Guests at many hotels receive a Ticino Ticket for transport.";
"swiss.discovery.lugano.season" = "All year";
"swiss.discovery.lugano.duration" = "Full day";
"swiss.discovery.lugano.route" = "Station → Piazza della Riforma → LAC → Parco Ciani → waterfront.";
"swiss.discovery.davos.title" = "Davos";
"swiss.discovery.davos.region" = "Graubünden · GR";
"swiss.discovery.davos.summary" = "High-alpine town with a lake, Parsenn routes, congress heritage and culture at 1,560 metres.";
"swiss.discovery.davos.details" = "Davos is both an Alpine resort and international meeting destination. Cable cars reach Parsenn and Jakobshorn, the funicular climbs to Schatzalp, while Kirchner Museum and the lake offer calmer alternatives.";
"swiss.discovery.davos.tip" = "Allow for altitude and fast-changing weather. Check guest cards, lift seasons and current trail conditions.";
"swiss.discovery.davos.season" = "All year";
"swiss.discovery.davos.duration" = "Half or full day";
"swiss.discovery.davos.route" = "Davos Platz → Kirchner Museum → Schatzalp, or Davos Dorf → Parsenn.";
"swiss.discovery.ascona.title" = "Ascona";
"swiss.discovery.ascona.region" = "Ticino · Lake Maggiore";
"swiss.discovery.ascona.summary" = "Colourful Lake Maggiore promenade, old town, Monte Verità’s artistic heritage and nearby Locarno.";
"swiss.discovery.ascona.details" = "Ascona has an almost Mediterranean rhythm: Piazza Giuseppe Motta opens onto the lake, while narrow lanes lead to galleries and churches. Monte Verità tells the story of artists and reformers, and boats connect town to the Brissago Islands.";
"swiss.discovery.ascona.tip" = "The promenade gets busy on weekends. Check boat schedules and arrive early for a quieter walk.";
"swiss.discovery.ascona.season" = "March — November";
"swiss.discovery.ascona.duration" = "Half day";
"swiss.discovery.ascona.route" = "Piazza Motta → old town → Monte Verità → boat to Brissago Islands.";
"swiss.discovery.engadin.title" = "Engadin and St Moritz";
"swiss.discovery.engadin.region" = "Graubünden · GR";
"swiss.discovery.engadin.summary" = "High-alpine lakes, Romansh villages, the Bernina railway and routes around St Moritz.";
"swiss.discovery.engadin.details" = "The Engadin valley links Lakes St Moritz, Silvaplana and Sils with villages decorated in sgraffito. Rhaetian Railway, Muottas Muragl, Zuoz and the Bernina route offer everything from an easy panorama to a full mountain day.";
"swiss.discovery.engadin.tip" = "Altitude is noticeable even on easy routes. Check weather, RhB tickets and guest transport offers.";
"swiss.discovery.engadin.season" = "All year";
"swiss.discovery.engadin.duration" = "Full day";
"swiss.discovery.engadin.route" = "St Moritz → lake trail → Muottas Muragl, or RhB train to Pontresina and Bernina.";
