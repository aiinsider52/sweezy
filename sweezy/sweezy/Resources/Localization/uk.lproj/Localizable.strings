"swiss.discovery.oeschinen.region" = "Бернський Оберланд · Кандерштег";
"swiss.discovery.oeschinen.summary" = "Бірюзове альпійське озеро під скелями Blüemlisalp — для спокійної прогулянки, пікніка або гірського маршруту.";
"swiss.discovery.oeschinen.tip" = "У популярні дні бронюйте час підйому на гондолі. Купання залежить від температури, а дрони в охоронній зоні обмежені.";
"swiss.discovery.oeschinen.season" = "Цілий рік";
"swiss.discovery.oeschinen.duration" = "Пів дня";
"swiss.discovery.oeschinen.route" = "Гондола з Kandersteg, потім приблизно 25–30 хвилин пішки. Від верхньої станції є зручний широкий шлях.";

"swiss.discovery.ruinaulta.title" = "Ущелина Ruinaulta";
"swiss.discovery.ruinaulta.region" = "Граубюнден · Флімс";
"swiss.discovery.ruinaulta.summary" = "Білі скелі, бірюзовий Передній Рейн і червоні поїзди Ретійської залізниці створюють швейцарський «Гранд-Каньйон».";
"swiss.discovery.ruinaulta.tip" = "Для легкого дня поєднайте оглядовий майданчик Il Spir із поїздом через ущелину. Для походу перевірте стан стежок.";
"swiss.discovery.ruinaulta.season" = "Цілий рік";
"swiss.discovery.ruinaulta.duration" = "2–5 годин";
"swiss.discovery.ruinaulta.route" = "Автобус до Flims Waldhaus і прогулянка до Il Spir або панорамна поїздка залізницею вздовж Рейну.";

"swiss.discovery.generoso.title" = "Monte Generoso";
"swiss.discovery.generoso.region" = "Тічино · Мендрізіо";
"swiss.discovery.generoso.summary" = "Зубчаста залізниця веде на висоту 1704 м до Fiore di Pietra та панорами озер, Альп і Північної Італії.";
"swiss.discovery.generoso.tip" = "Перевірте прогноз на вершині та сезонний розклад поїзда. Навіть у теплий день нагорі може бути вітряно.";
"swiss.discovery.generoso.season" = "Весна — осінь";
"swiss.discovery.generoso.duration" = "Пів дня";
"swiss.discovery.generoso.route" = "Зубчастий поїзд із Capolago до вершини. На місці є короткі прогулянки та довші гірські стежки.";

"swiss.discovery.st_gallen.title" = "Абатський квартал Санкт-Галлена";
"swiss.discovery.st_gallen.region" = "Санкт-Галлен · SG";
"swiss.discovery.st_gallen.summary" = "Ансамбль UNESCO з бароковим собором і однією з найстаріших бібліотек світу — культурний маршрут у центрі міста.";
"swiss.discovery.st_gallen.tip" = "Перевірте години роботи бібліотеки та можливі сезонні закриття. У залах діють правила щодо фото й захисного взуття.";
"swiss.discovery.st_gallen.season" = "Цілий рік";
"swiss.discovery.st_gallen.duration" = "1–2 години";
"swiss.discovery.st_gallen.route" = "Коротка прогулянка від вокзалу St. Gallen через старе місто до собору й Abbey Library.";

"swiss.discovery.matterhorn.title" = "Маттергорн";
"swiss.discovery.matterhorn.region" = "Церматт · Вале";
"swiss.discovery.matterhorn.summary" = "Символ Швейцарії заввишки 4478 м над Церматтом без автомобілів, із класичними краєвидами з Gornergrat і Sunnegga.";
"swiss.discovery.matterhorn.tip" = "Перевірте гірський прогноз і вирушайте рано. Видимість та умови можуть швидко змінитися.";
"swiss.discovery.matterhorn.season" = "Цілий рік";
"swiss.discovery.matterhorn.duration" = "Цілий день";
"swiss.discovery.matterhorn.route" = "Доїдьте до Церматта, підніміться залізницею Gornergrat і пройдіть маркованим панорамним маршрутом.";
"swiss.discovery.jungfraujoch.title" = "Юнгфрауйох — вершина Європи";
"swiss.discovery.jungfraujoch.region" = "Бернський Оберланд";
"swiss.discovery.jungfraujoch.summary" = "Найвища залізнична станція Європи на 3454 м із видом на льодовик, терасою Sphinx та Крижаним палацом.";
"swiss.discovery.jungfraujoch.tip" = "З травня до серпня бронюйте місце та беріть теплий одяг навіть улітку. Враховуйте висоту.";
"swiss.discovery.jungfraujoch.season" = "Цілий рік";
"swiss.discovery.jungfraujoch.duration" = "Цілий день";
"swiss.discovery.jungfraujoch.route" = "Grindelwald Terminal → Eiger Express → Eigergletscher → Jungfraujoch.";
"swiss.discovery.bern.title" = "Старе місто Берна";
"swiss.discovery.bern.region" = "Берн · BE";
"swiss.discovery.bern.summary" = "Старе місто UNESCO із шістьма кілометрами аркад, Zytglogge, собором і краєвидами на Ааре.";
"swiss.discovery.bern.tip" = "Почніть у Rosengarten, пройдіть старим містом і завершіть біля BärenPark над Ааре.";
"swiss.discovery.bern.season" = "Цілий рік";
"swiss.discovery.bern.duration" = "Пів дня або день";
"swiss.discovery.bern.route" = "Вокзал Берна → Bundesplatz → Zytglogge → собор → BärenPark.";
"swiss.discovery.rigi.title" = "Гора Рігі";
"swiss.discovery.rigi.region" = "Центральна Швейцарія";
"swiss.discovery.rigi.summary" = "«Королева гір» між трьома озерами: корабель, зубчаста залізниця та 120 км пішохідних маршрутів.";
"swiss.discovery.rigi.tip" = "Складіть круговий маршрут із кораблем і поїздом та перевірте гірський розклад перед виїздом.";
"swiss.discovery.rigi.season" = "Цілий рік";
"swiss.discovery.rigi.duration" = "Пів дня або день";
"swiss.discovery.rigi.route" = "Люцерн → корабель до Vitznau → зубчаста залізниця до Rigi Kulm.";
"swiss.discovery.aletsch.details" = "Алечський льодовик входить до регіону Юнгфрау-Алеч під охороною UNESCO. З оглядових майданчиків Eggishorn, Bettmerhorn і Moosfluh видно льодовиковий потік, гірські села без автомобілів і крихкий високогірний ландшафт, що швидко змінюється через клімат.";
"swiss.discovery.lavaux.details" = "Виноградні тераси Лаво простягаються між Лозанною та Монтре й понад вісім століть формують культурний ландшафт над Женевським озером. Стежки з’єднують Cully, Epesses, Rivaz і виноробні села, а залізниця дозволяє легко скоротити маршрут.";
"swiss.discovery.creux.details" = "Creux du Van — природний кам’яний амфітеатр Юри зі стінами до 160 метрів. Круговий маршрут із Noiraigue проходить через ліс, пасовища та оглядові точки; тут можна побачити серн і козерогів, якщо тримати дистанцію та не сходити зі стежки.";
"swiss.discovery.rhine.details" = "Рейнський водоспад найкраще відкривається з двох берегів: платформи Schloss Laufen підводять майже до води, а Neuhausen дає широкий панорамний вид. У теплий сезон працюють човни до центральної скелі, проте розклад залежить від погоди й рівня води.";
"swiss.discovery.oeschinen.details" = "Озеро Ешинензее лежить у високогірному ландшафті UNESCO над Kandersteg. Від верхньої станції канатної дороги ведуть легка прогулянка до берега та складніші панорамні маршрути; крихку природу варто берегти й перевіряти обмеження перед поїздкою.";
"swiss.discovery.ruinaulta.details" = "Рейнська ущелина виникла після гігантського Флімського зсуву й сьогодні поєднує білі скелі, хвойний ліс і бірюзову воду Переднього Рейну. Її можна побачити з Il Spir, пройти пішки або проїхати Ретійською залізницею вздовж річки.";
"swiss.discovery.generoso.details" = "Monte Generoso поєднує зубчасту залізницю, геологічні маршрути та панораму озер Тічино й Північної Італії. На вершині стоїть Fiore di Pietra Маріо Ботти; від станції починаються короткі прогулянки та довші гірські стежки.";
"swiss.discovery.st_gallen.details" = "Монастирський квартал St. Gallen з бароковим собором і бібліотекою входить до списку UNESCO. Усередині зберігаються стародавні рукописи, а навколо — компактне старе місто з еркерами, музеями текстилю та пішохідними вулицями.";
"swiss.discovery.matterhorn.details" = "Маттергорн височіє над безавтомобільним Церматтом і має різні оглядові маршрути для будь-якого сезону. Gornergrat відкриває класичну панораму вершини та льодовиків, Sunnegga — швидший сімейний варіант, а село зберігає історію альпінізму.";
"swiss.discovery.jungfraujoch.details" = "Подорож до Jungfraujoch проходить крізь гори до станції на висоті 3454 метри. Нагорі розташовані тераса Sphinx, льодовий палац і вид на Алецький льодовик; через висоту потрібні теплий одяг, повільний темп і перевірка медичних обмежень.";
"swiss.discovery.bern.details" = "Історичний центр Берна входить до UNESCO та зручний для прогулянок за будь-якої погоди завдяки шести кілометрам аркад. Маршрут з’єднує Bundesplatz, годинникову вежу Zytglogge, собор, міст над Ааре й BärenPark.";
"swiss.discovery.rigi.details" = "Рігі лежить між Люцернським, Цузьким і Лауерцьким озерами та доступна історичною зубчастою залізницею. Кругова подорож кораблем і потягом поєднує панорамні зупинки, легкі прогулянки, довші стежки та мінеральні купальні.";

"swiss.discovery.zurich.title" = "Цюрих";
"swiss.discovery.zurich.region" = "Цюрих · ZH";
"swiss.discovery.zurich.summary" = "Озеро, старе місто, музеї та один із найсильніших інноваційних центрів Європи — усе поєднано швидким транспортом.";
"swiss.discovery.zurich.details" = "Цюрих легко досліджувати пішки: від головного вокзалу маршрут веде Bahnhofstrasse до Lindenhof, старого міста, набережної Ліммату й озера. Поруч розташовані Grossmünster, Kunsthaus, Zürich-West і десятки просторів для технологій, дизайну та підприємництва.";
"swiss.discovery.zurich.tip" = "Поєднайте старе місто вранці, Zürich-West після обіду й озеро ввечері. Денний квиток ZVV часто вигідніший за окремі поїздки.";
"swiss.discovery.zurich.season" = "Цілий рік";
"swiss.discovery.zurich.duration" = "Цілий день";
"swiss.discovery.zurich.route" = "Zürich HB → Bahnhofstrasse → Lindenhof → Grossmünster → Bellevue → набережна озера.";
"swiss.discovery.geneva.title" = "Женева";
"swiss.discovery.geneva.region" = "Женева · GE";
"swiss.discovery.geneva.summary" = "Місто дипломатії на березі озера: Jet d’Eau, старе місто, ООН, Червоний Хрест і міжнародна атмосфера.";
"swiss.discovery.geneva.details" = "Женева поєднує набережні з Jet d’Eau, історичний центр навколо собору Saint-Pierre та міжнародний квартал із Palais des Nations. Музеї, CERN, годинникова спадщина й близькість французьких Альп роблять місто корисним і для відпочинку, і для ділової подорожі.";
"swiss.discovery.geneva.tip" = "Робота Jet d’Eau залежить від погоди. Для екскурсій до ООН або CERN перевірте бронювання й документи заздалегідь.";
"swiss.discovery.geneva.season" = "Цілий рік";
"swiss.discovery.geneva.duration" = "Цілий день";
"swiss.discovery.geneva.route" = "Gare Cornavin → озеро → Jet d’Eau → старе місто → трамвай до Nations.";
"swiss.discovery.lucerne.title" = "Люцерн";
"swiss.discovery.lucerne.region" = "Люцерн · LU";
"swiss.discovery.lucerne.summary" = "Капельбрюкке, старе місто, Люцернське озеро й гори Пілатус та Рігі в одному компактному маршруті.";
"swiss.discovery.lucerne.details" = "Люцерн зручно починати з вокзалу: поруч KKL, набережна, Капельбрюкке й розписані фасади старого міста. З пристані можна продовжити день кораблем до Vitznau або Alpnachstad і піднятися на Рігі чи Пілатус.";
"swiss.discovery.lucerne.tip" = "Для кругового маршруту звірте розклад кораблів і гірських залізниць. У ясну погоду залиште другу половину дня для вершини.";
"swiss.discovery.lucerne.season" = "Цілий рік";
"swiss.discovery.lucerne.duration" = "Пів дня або день";
"swiss.discovery.lucerne.route" = "Вокзал → KKL → Капельбрюкке → старе місто → Löwendenkmal → набережна.";
"swiss.discovery.basel.title" = "Базель";
"swiss.discovery.basel.region" = "Базель · BS";
"swiss.discovery.basel.summary" = "Столиця мистецтва на Рейні з музеями світового рівня, сучасною архітектурою та живим старим містом.";
"swiss.discovery.basel.details" = "Базель об’єднує Kunstmuseum, Fondation Beyeler, ярмарки Messe Basel і архітектуру міжнародних бюро. Між Rathaus, собором і набережною Рейну легко побудувати пішохідний маршрут, а пором через річку працює лише на течії.";
"swiss.discovery.basel.tip" = "Перевірте дні роботи музеїв і комбіновані квитки. Купайтеся в Рейні лише на офіційних ділянках і за безпечних умов.";
"swiss.discovery.basel.season" = "Цілий рік";
"swiss.discovery.basel.duration" = "Цілий день";
"swiss.discovery.basel.route" = "Barfüsserplatz → Rathaus → Münster → Рейн → музейний квартал.";
"swiss.discovery.lausanne.title" = "Лозанна";
"swiss.discovery.lausanne.region" = "Во · VD";
"swiss.discovery.lausanne.summary" = "Місто на пагорбах із готичним собором, Олімпійським музеєм, набережною Ouchy та видом на Альпи.";
"swiss.discovery.lausanne.details" = "Лозанна піднімається від озера до середньовічного центру, тому метро M2 зручно поєднує Ouchy, вокзал і собор. Місто відоме Олімпійським музеєм, університетами, стартапами й близькістю виноградників Лаво.";
"swiss.discovery.lausanne.tip" = "Рельєф крутий: спускайтеся пішки, а вгору користуйтеся метро. Денний транспортний квиток спростить маршрут.";
"swiss.discovery.lausanne.season" = "Цілий рік";
"swiss.discovery.lausanne.duration" = "Цілий день";
"swiss.discovery.lausanne.route" = "Собор → Place de la Palud → метро M2 → Ouchy → Олімпійський музей.";
"swiss.discovery.montreux.title" = "Монтре";
"swiss.discovery.montreux.region" = "Во · Женевське озеро";
"swiss.discovery.montreux.summary" = "Пальмова набережна, замок Шийон, музична історія й альпійські краєвиди Швейцарської Рив’єри.";
"swiss.discovery.montreux.details" = "Монтре простягається вздовж озера між садами, Belle Époque готелями та концертними майданчиками. Прогулянку легко продовжити до Château de Chillon, виноградників Лаво або панорамної залізниці Rochers-de-Naye.";
"swiss.discovery.montreux.tip" = "Поєднайте набережну із замком Шийон. Під час фестивалів бронюйте транспорт і житло раніше.";
"swiss.discovery.montreux.season" = "Цілий рік";
"swiss.discovery.montreux.duration" = "Пів дня або день";
"swiss.discovery.montreux.route" = "Вокзал → набережна → пам’ятник Freddie Mercury → корабель або автобус до Château de Chillon.";
"swiss.discovery.lugano.title" = "Лугано";
"swiss.discovery.lugano.region" = "Тічино · TI";
"swiss.discovery.lugano.summary" = "Середземноморська атмосфера, озеро, італійська архітектура та панорами Monte Brè і San Salvatore.";
"swiss.discovery.lugano.details" = "Лугано поєднує Piazza della Riforma, парк Ciani, культурний центр LAC і довгу озерну набережну. Фунікулери на Monte Brè та San Salvatore відкривають легкий доступ до панорамних стежок над містом.";
"swiss.discovery.lugano.tip" = "Перевірте сезонний розклад кораблів і фунікулерів. Гості багатьох готелів отримують Ticino Ticket для транспорту.";
"swiss.discovery.lugano.season" = "Цілий рік";
"swiss.discovery.lugano.duration" = "Цілий день";
"swiss.discovery.lugano.route" = "Вокзал → Piazza della Riforma → LAC → парк Ciani → набережна.";
"swiss.discovery.davos.title" = "Давос";
"swiss.discovery.davos.region" = "Граубюнден · GR";
"swiss.discovery.davos.summary" = "Високогірне місто з озером, маршрутами Parsenn, історією конгресів і культурою на висоті 1560 метрів.";
"swiss.discovery.davos.details" = "Давос відомий як альпійський курорт і міжнародний діловий центр. Канатні дороги ведуть до Parsenn і Jakobshorn, фунікулер — до Schatzalp, а музей Kirchner і озеро дають спокійні альтернативи гірським активностям.";
"swiss.discovery.davos.tip" = "Враховуйте висоту й мінливу погоду. Перевірте гостьову картку, сезон роботи підйомників і стан стежок.";
"swiss.discovery.davos.season" = "Цілий рік";
"swiss.discovery.davos.duration" = "Пів дня або день";
"swiss.discovery.davos.route" = "Davos Platz → Kirchner Museum → Schatzalp або Davos Dorf → Parsenn.";
"swiss.discovery.ascona.title" = "Аскона";
"swiss.discovery.ascona.region" = "Тічино · Lago Maggiore";
"swiss.discovery.ascona.summary" = "Кольорова набережна Lago Maggiore, старе місто, мистецька спадщина Monte Verità та близький Локарно.";
"swiss.discovery.ascona.details" = "Аскона має майже середземноморський ритм: Piazza Giuseppe Motta виходить до озера, а вузькі вулиці ведуть до галерей і церков. Monte Verità розповідає історію художників і реформаторів, а кораблі з’єднують місто з островами Brissago.";
"swiss.discovery.ascona.tip" = "У вихідні набережна людна. Перевірте розклад кораблів і приїжджайте раніше для спокійної прогулянки.";
"swiss.discovery.ascona.season" = "Березень — листопад";
"swiss.discovery.ascona.duration" = "Пів дня";
"swiss.discovery.ascona.route" = "Piazza Motta → старе місто → Monte Verità → корабель до островів Brissago.";
"swiss.discovery.engadin.title" = "Енгадін і Санкт-Моріц";
"swiss.discovery.engadin.region" = "Граубюнден · GR";
"swiss.discovery.engadin.summary" = "Високогірні озера, ретороманські села, Бернінська залізниця та маршрути навколо Санкт-Моріца.";
"swiss.discovery.engadin.details" = "Долина Енгадін поєднує озера St. Moritz, Silvaplana й Sils із селами, прикрашеними сграфіто. Ретійська залізниця, Muottas Muragl, Zuoz і Бернінський маршрут дають багато форматів — від легкої панорами до повного дня в горах.";
"swiss.discovery.engadin.tip" = "Висота відчувається навіть на легких маршрутах. Перевірте погоду, квитки RhB та гостьові транспортні пропозиції.";
"swiss.discovery.engadin.season" = "Цілий рік";
